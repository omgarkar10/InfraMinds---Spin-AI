[Unit]
Description=SPIN FastAPI Backend Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/backend/.env
Environment="PYTHONPATH=/home/ubuntu/app:/home/ubuntu/app/backend"
ExecStart=/home/ubuntu/app/venv/bin/uvicorn spin_agents.api:app --host 127.0.0.1 --port 8080 --workers 1
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

