# ─────────────────────────────────────────────────────────
# SPIN Frontend — Environment Variables Template
#
# Copy this file to `.env` inside `frontend/dashboard/` for local development.
# For production, set these as environment variables in your hosting platform.
# ─────────────────────────────────────────────────────────

# URL of the SPIN FastAPI backend (default local: http://127.0.0.1:8080/api)
VITE_API_URL=http://127.0.0.1:8080/api

# Google Maps JavaScript API key (Required for heatmaps and Google Places autocomplete)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Authentication Web SDK Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
